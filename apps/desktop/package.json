{
  "name": "rimmerge-desktop",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:screenshots": "playwright test --config e2e/screenshots/playwright.config.ts",
    "e2e:smoke": "playwright test --config e2e/smoke/playwright.config.ts",
    "e2e:smoke:i18n": "playwright test --config e2e/smoke/i18n/playwright.config.ts",
    "types:check": "node scripts/check-types-drift.mjs",
    "i18n:status": "node scripts/i18n-status.mjs"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.5",
    "@primevue/themes": "4.5.4",
    "@tanstack/vue-virtual": "^3.13.39",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.1",
    "primevue": "4.5.5",
    "vue": "3.5.43",
    "vue-i18n": "^11",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.6",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
