{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Overrides (doesn't merge with) the base config's `lib` — repeats its
    // ES2022/DOM/DOM.Iterable and adds `ES2023.Array` for `Array.prototype.toSorted`/
    // `toReversed`/`toSpliced`/`with`, which Vite's ES2022 build target already
    // supports at runtime (they're just missing from the ES2022 lib's types).
    "lib": ["ES2022", "ES2023.Array", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/*.test.ts", "e2e/**/*"]
}
